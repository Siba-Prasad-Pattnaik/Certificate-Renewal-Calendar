# Environment Configuration
# Copy this file to .env.local for local development

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEPLOY_TARGET=vercel # vercel|static

# Email Configuration (optional - set to enable email sending)
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@example.com

# Security & Authentication
JWT_SECRET=change-this-to-a-secure-random-string
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH= # hashed password for admin user

# Cloudflare Turnstile (optional - set to enable bot protection)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Storage Configuration
STORAGE_DRIVER=local # local|blob
BLOB_READ_WRITE_TOKEN= # Required when STORAGE_DRIVER=blob

# Analytics (optional)
ANALYTICS_PROVIDER= # vercel|google-analytics|plausible

# Form Submission (optional)
FORMSPREE_ENDPOINT=

# Application
NODE_ENV=development
PORT=3000